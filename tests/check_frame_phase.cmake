execute_process(COMMAND "${PROBE}" valid RESULT_VARIABLE valid)
if(NOT "${valid}" STREQUAL "0")
    message(FATAL_ERROR "A legal lifecycle operation failed: ${valid}")
endif()
execute_process(COMMAND "${PROBE}" invalid
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(FATAL_CHECKS)
    if("${result}" STREQUAL "0" OR output MATCHES "client continued")
        message(FATAL_ERROR "Invalid lifecycle operation did not terminate the process")
    endif()
else()
    if(NOT "${result}" STREQUAL "0" OR NOT output MATCHES "client continued")
        message(FATAL_ERROR "Release did not continue: ${result}, ${errors}, ${output}")
    endif()
    foreach(pair IN ITEMS "world entry requires phase Transitions; current phase is Network"
                          "world entry requires phase Transitions; current phase is Render"
                          "world logout requires phase Transitions; current phase is Network")
        string(LENGTH "${output}" before)
        string(REPLACE "${pair}" "" without_pair "${output}")
        string(LENGTH "${without_pair}" after)
        string(LENGTH "${pair}" pair_length)
        math(EXPR count "(${before} - ${after}) / ${pair_length}")
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "Expected one log for ${pair}, got ${count}: ${output}")
        endif()
    endforeach()
endif()
