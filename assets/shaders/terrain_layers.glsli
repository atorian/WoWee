// A terrain chunk's layers - its base texture and up to three more over it by
// their alpha maps - and their relief, blended. The one copy of how they mix:
// terrain.frag.glsl draws the ground from it, and terrain_bake.frag.glsl
// bakes the far ground's atlas from it (TerrainBake), so a chunk seen through
// its bake is the same ground.
//
// The includer defines TEXTURE_TABLE_SET and TERRAIN_CHUNK_SET, the sets the
// texture table and the terrain's chunk rows are bound at, and TERRAIN_CHUNK,
// the drawn chunk's row.

#include "texture_table.glsli"

// A chunk as TerrainRenderer keeps it (TerrainChunkRowGPU), its textures by
// handle: the base and the three layers over it in color; each texture's
// relief in relief, derived from its colours when the tile loaded
// (TerrainRenderer::deriveNormalMap) - the normal in rgb, along the
// texture's u and v and out of it; the tile's maps and bake atlas in maps.
struct TerrainChunk {
    uvec4 color;
    uvec4 relief;
    // x: what the three layers cover, for every chunk of the tile
    // (TerrainTileMaps) - the chunk's at layer mapLayer, the first layer's
    // cover in r, the second's in g, the third's in b. y: the chunk's own
    // normals, likewise. z, w: the tile's bake atlas, colour and relief.
    uvec4 maps;
    // x: how many layers lie over the base; y: the chunk's layer in its
    // tile's maps (TerrainChunkSlot).
    ivec4 layers;
};
layout(std430, set = TERRAIN_CHUNK_SET, binding = 0) readonly buffer TerrainChunks {
    TerrainChunk terrainChunks[];
};

#define TERRAIN_ROW (terrainChunks[TERRAIN_CHUNK])
#define layerCount (TERRAIN_ROW.layers.x)
#define mapLayer (TERRAIN_ROW.layers.y)
#define hasLayer1 int(layerCount >= 1)
#define hasLayer2 int(layerCount >= 2)
#define hasLayer3 int(layerCount >= 3)
#define uBaseTexture tablePlain2D(TERRAIN_ROW.color.x)
#define uLayer1Texture tablePlain2D(TERRAIN_ROW.color.y)
#define uLayer2Texture tablePlain2D(TERRAIN_ROW.color.z)
#define uLayer3Texture tablePlain2D(TERRAIN_ROW.color.w)
#define uBaseNormal tablePlain2D(TERRAIN_ROW.relief.x)
#define uLayer1Normal tablePlain2D(TERRAIN_ROW.relief.y)
#define uLayer2Normal tablePlain2D(TERRAIN_ROW.relief.z)
#define uLayer3Normal tablePlain2D(TERRAIN_ROW.relief.w)
#define uTileCover tableLayered2D(TERRAIN_ROW.maps.x)

// Every read below takes its gradients from the caller - the coordinate's
// dFdx and dFdy, taken in uniform control flow - so a pixel may skip the
// layers while its neighbour reads them, and the mips are still the ones the
// whole quad would have chosen.

// How much of each layer covers a point: the three layers' alpha, and what is
// left of the base under them. Maps uploaded by the mesh generator contain
// absolute coverage. Big alpha must not be blended as successive opacities:
// that exposes the base layer and changes the blend when adjacent chunks
// reorder textures.
struct TerrainCoverage {
    vec3 layers;
    float base;
};

TerrainCoverage terrainCoverage(vec2 layerUV, vec2 dx, vec2 dy) {
    TerrainCoverage c;
    vec3 cover = textureGrad(uTileCover, vec3(layerUV, float(mapLayer)), dx, dy).rgb;
    c.layers = vec3(hasLayer1 != 0 ? cover.r : 0.0,
                    hasLayer2 != 0 ? cover.g : 0.0,
                    hasLayer3 != 0 ? cover.b : 0.0);
    float total = c.layers.x + c.layers.y + c.layers.z;
    c.layers /= max(total, 1.0);
    c.base = max(1.0 - total, 0.0);
    return c;
}

vec4 terrainColor(TerrainCoverage c, vec2 uv, vec2 dx, vec2 dy) {
    vec4 color = textureGrad(uBaseTexture, uv, dx, dy) * c.base;
    if (hasLayer1 != 0) color += textureGrad(uLayer1Texture, uv, dx, dy) * c.layers.x;
    if (hasLayer2 != 0) color += textureGrad(uLayer2Texture, uv, dx, dy) * c.layers.y;
    if (hasLayer3 != 0) color += textureGrad(uLayer3Texture, uv, dx, dy) * c.layers.z;
    return color;
}

// The relief of each layer, blended as its colour is, as stored (rgb, the
// normal * 0.5 + 0.5). It is read from maps made of the textures, not from
// how the shaded colour changes from one pixel to the next on screen: that
// answer belonged to the pixel grid, so it changed with every sub-pixel move
// of the camera and crawled over the ground in 2x2 blocks. The maps' mips
// flatten it with distance as the colour's mips soften the colour.
vec3 terrainRelief(TerrainCoverage c, vec2 uv, vec2 dx, vec2 dy) {
    vec3 relief = textureGrad(uBaseNormal, uv, dx, dy).rgb * c.base;
    if (hasLayer1 != 0) relief += textureGrad(uLayer1Normal, uv, dx, dy).rgb * c.layers.x;
    if (hasLayer2 != 0) relief += textureGrad(uLayer2Normal, uv, dx, dy).rgb * c.layers.y;
    if (hasLayer3 != 0) relief += textureGrad(uLayer3Normal, uv, dx, dy).rgb * c.layers.z;
    return relief;
}

// Where a point of the chunk is across it, 0 to 1 each way, from its alpha-map
// coordinate: LayerUV runs over the alpha maps' texel centres,
// (offset * 63/8 + 0.5) / 64 for a grid offset of 0 to 8.
vec2 terrainChunkLocal(vec2 layerUV) {
    return (layerUV * 64.0 - 0.5) * (8.0 / 63.0) / 8.0;
}
