// Six authored sky colours, shared by the sky dome and water reflections.
// The radial profile is the WoW dome documented by noclip's mesh.ts:
// https://github.com/magcius/noclip.website/blob/main/src/WorldOfWarcraft/mesh.ts
// (radius, height), from top to bottom: (0,.29289323), (.49034798,.13914520),
// (.56799996,.08489323), (.64133203,.02416122), (.65308857,.01345474),
// (.6875,-.005). Its bottom pole has the same fog colour as the last ring.
// Intersect the viewing ray with each conical band; do not invent a dark
// nadir, horizon glow or night tint on top of the authored colours.
vec3 skyDomeBand(float slope, float upperRadius, float upperHeight,
                 float lowerRadius, float lowerHeight, vec3 upper, vec3 lower) {
    float radialSpan = lowerRadius - upperRadius;
    float heightSpan = lowerHeight - upperHeight;
    float weight = (upperHeight - slope * upperRadius) /
                   max(slope * radialSpan - heightSpan, 0.000001f);
    return mix(upper, lower, clamp(weight, 0.0f, 1.0f));
}

vec3 atmosphereSkyColor(vec3 worldDir, vec3 zenith, vec3 middle,
                        vec3 band1, vec3 band2, vec3 smog, vec3 fog) {
    float horizontal = sqrt(worldDir.x * worldDir.x + worldDir.y * worldDir.y);
    if (horizontal == 0.0f) return worldDir.z > 0.0f ? zenith : fog;
    float slope = worldDir.z / horizontal;
    if (slope >= 0.13914520f / 0.49034798f)
        return skyDomeBand(slope, 0.0f, 0.29289323f, 0.49034798f, 0.13914520f,
                           zenith, middle);
    if (slope >= 0.08489323f / 0.56799996f)
        return skyDomeBand(slope, 0.49034798f, 0.13914520f, 0.56799996f, 0.08489323f,
                           middle, band1);
    if (slope >= 0.02416122f / 0.64133203f)
        return skyDomeBand(slope, 0.56799996f, 0.08489323f, 0.64133203f, 0.02416122f,
                           band1, band2);
    if (slope >= 0.01345474f / 0.65308857f)
        return skyDomeBand(slope, 0.64133203f, 0.02416122f, 0.65308857f, 0.01345474f,
                           band2, smog);
    if (slope > -0.005f / 0.6875f)
        return skyDomeBand(slope, 0.65308857f, 0.01345474f, 0.6875f, -0.005f,
                           smog, fog);
    return fog;
}

float distanceFogVisibility(float dist, float start, float end) {
    return clamp((end - dist) / max(end - start, 0.001f), 0.0f, 1.0f);
}

float distanceHazeVisibility(float dist, float horizontalDist,
                             float start, float end, float viewDistance) {
    // Keep the zone's first half of the linear gradient. Continue beyond
    // that with a reciprocal tail matching both its value and slope at 50%:
    // 1-p and 0.25/p are both 0.5, with derivative -1, at p=0.5.
    // The authored end is a density reference, not a wall hiding distant
    // terrain. This is a contrast curve, not another volumetric fog layer.
    float progress = max((dist - start) / max(end - start, 0.001f), 0.0f);
    float visibility = progress <= 0.5f ? 1.0f - progress : 0.25f / progress;
    // Geometry is culled by horizontal radius. Blend the remaining contrast
    // to the actual sky over the final tenth of that radius, regardless of
    // the zone's range, so increasing View Distance does not clear near fog.
    float limit = max(viewDistance, 0.001f);
    return visibility * (1.0f - smoothstep(limit * 0.9f, limit, horizontalDist));
}

// Mean aerosol density along a straight segment through an exponential layer.
// Below the regional ground datum the density is bounded; the horizontal-ray
// limit uses a series so neither flat views nor small height changes divide by 0.
float hazeColumnDensity(float fromZ, float toZ, float groundZ, float inverseHeight) {
    float lo = (min(fromZ, toZ) - groundZ) * inverseHeight;
    float hi = (max(fromZ, toZ) - groundZ) * inverseHeight;
    if (hi <= 0.0f) return 1.0f;
    float below = clamp(-lo / max(hi - lo, 0.000001f), 0.0f, 1.0f);
    lo = max(lo, 0.0f);
    float span = hi - lo;
    float mean = exp(-lo) * (span < 0.001f
        ? 1.0f - span * 0.5f + span * span / 6.0f
        : (1.0f - exp(-span)) / span);
    return mix(mean, 1.0f, below);
}

// Preview switch shared by surface extinction and ray-march integration.
#ifndef AERIAL_FAR_DENSITY_ENABLED
#define AERIAL_FAR_DENSITY_ENABLED 0
#endif
float distanceHeightHazeVisibility(float dist, float horizontalDist,
    float start, float end, float viewDistance, float eyeZ, float surfaceZ,
    float groundZ, float inverseHeight, float thickness) {
    float density = clamp(thickness, 0.0f, 2.0f);
    if (density <= 0.001f) return 1.0f;
    // Frame extraction scales the authored ranges by 1/thickness for linear
    // fog consumers. Recover one fixed reference profile before applying
    // density, otherwise the slider both moves and thickens the same medium.
    // 0.8 is the calibrated long-view appearance. Preserve its near gradient
    // and height-dependent tail; change optical depth at other settings:
    // doubling density squares transmission instead of merely moving the tail.
    float relativeDensity = density / 0.8f;
    start *= relativeDensity;
    end *= relativeDensity;
    float nearDistance = min(dist, max(start + 0.5f * (end - start), 0.0f));
    float opticalDistance = dist;
    if (dist > nearDistance) {
        float nearZ = mix(eyeZ, surfaceZ, nearDistance / max(dist, 0.001f));
        float column = mix(0.02f, 1.0f, hazeColumnDensity(nearZ, surfaceZ, groundZ, inverseHeight));
        opticalDistance = nearDistance + (dist - nearDistance) * column;
    }
#if AERIAL_FAR_DENSITY_ENABLED
    // Preserve the authored near half of the profile. Add optical depth only
    // beyond it, with a smooth onset over one further half-transmission.
    // Far-air density tends to 1.25 / 0.8 times the existing density.
    // Keep the artificial geometry-boundary fade out of this added medium.
    float air = distanceHazeVisibility(opticalDistance, 0.0, start, end, viewDistance);
    float nearAir = distanceHazeVisibility(nearDistance, 0.0, start, end, viewDistance);
    float farDepth = max(log(max(nearAir, 0.000001) / max(air, 0.000001)), 0.0);
    float extraDepth = (1.25 / 0.8 - 1.0) * farDepth * smoothstep(0.0, log(2.0), farDepth);
    float limit = max(viewDistance, 0.001);
    float boundary = 1.0 - smoothstep(0.9 * limit, limit, horizontalDist);
    return pow(air * exp(-extraDepth) * boundary, relativeDensity);
#else
    float reference = distanceHazeVisibility(opticalDistance, horizontalDist, start, end, viewDistance);
    return pow(reference, relativeDensity);
#endif
}
