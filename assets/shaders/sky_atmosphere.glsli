// The same atmospheric background for the skybox and distant surfaces.
// Clouds/stars stay in their own sky layers; they are not painted on objects.
vec3 atmosphereSkyColor(vec3 worldDir, vec3 sunDir, vec3 zenith,
                        vec3 middle, vec3 horizon, vec3 fringe) {
    // Elevation: +1 = zenith, 0 = horizon, -1 = nadir
    float elev = worldDir.z;
    float elevClamped = clamp(elev, 0.0f, 1.0f);

    // --- 3-band sky gradient using DBC colors ---
    // Zenith dominates upper sky, mid color fills the middle,
    // horizon band at the bottom with a thin fog fringe.
    vec3 sky;
    if (elevClamped > 0.4f) {
        // Upper sky: mid -> zenith
        float t = (elevClamped - 0.4f) / 0.6f;
        sky = mix(middle, zenith, t);
    } else if (elevClamped > 0.05f) {
        // Lower sky: horizon -> mid (wide band)
        float t = (elevClamped - 0.05f) / 0.35f;
        sky = mix(horizon, middle, t);
    } else {
        // Thin fog fringe right at horizon
        float t = elevClamped / 0.05f;
        sky = mix(fringe, horizon, t);
    }

    // --- Below-horizon darkening (nadir) ---
    if (elev < 0.0f) {
        float nadirFade = clamp(-elev * 3.0f, 0.0f, 1.0f);
        vec3 nadirColor = fringe * 0.3f;
        sky = mix(fringe, nadirColor, nadirFade);
    }

    // --- Rayleigh-like scattering (subtle warm glow near sun) ---
    float sunDot = max(dot(worldDir, sunDir), 0.0f);
    float sunAboveHorizon = clamp(sunDir.z, 0.0f, 1.0f);

    float rayleighStrength = pow(1.0f - elevClamped, 3.0f) * 0.15f;
    vec3 scatterColor = mix(vec3(0.8f, 0.45f, 0.15f), vec3(0.3f, 0.5f, 1.0f), elevClamped);
    sky += scatterColor * rayleighStrength * sunDot * sunAboveHorizon;

    // --- Mie-like forward scatter (sun disk glow) ---
    float mieSharp = pow(sunDot, 64.0f) * 0.4f;
    float mieSoft  = pow(sunDot, 8.0f) * 0.1f;
    vec3 sunGlowColor = mix(vec3(1.0f, 0.85f, 0.55f), vec3(1.0f, 1.0f, 0.95f), elevClamped);
    sky += sunGlowColor * (mieSharp + mieSoft) * sunAboveHorizon;

    // --- Subtle horizon haze ---
    float hazeDensity = exp(-elevClamped * 12.0f) * 0.06f;
    sky += horizon * hazeDensity * sunAboveHorizon;

    // --- Night: slight moonlight tint ---
    if (sunDir.z < 0.0f) {
        float moonlight = clamp(-sunDir.z * 0.5f, 0.0f, 0.15f);
        sky += vec3(0.02f, 0.03f, 0.08f) * moonlight;
    }

    return sky;
}

float distanceFogVisibility(float dist, float start, float end) {
    return clamp((end - dist) / max(end - start, 0.001f), 0.0f, 1.0f);
}

vec3 distanceFogTint(vec3 authored, vec3 sky, float dist,
                     float start, float end, float skyBlend) {
    // Match the background by the fog end, rather than retaining a colored
    // silhouette after every surface detail has already disappeared.
    float tail = smoothstep(start, max(end, start + 1.0f), dist);
    float blend = clamp(skyBlend * (1.0f + tail), 0.0f, 1.0f);
    return mix(authored, sky, blend);
}

float worldGeometryVisibility(float horizontalDistance, float range) {
    if (range <= 0.0f) return 1.0f; // portraits/standalone scenes
    return 1.0f - smoothstep(0.85f * range, range, horizontalDistance);
}
