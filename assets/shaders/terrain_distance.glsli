// Complementary coverage, shared by the detailed terrain and its WDL.
// Apply before lighting/depth writes. Bayer coverage keeps all MSAA samples
// together; the two representations never blend their colours twice.
float distantTerrainWeight(vec3 worldPos) {
    return terrainLodParams.z > 0.5 ? smoothstep(terrainLodParams.x,terrainLodParams.y,length(worldPos.xy-viewPos.xy)) : 0.0;
}
float terrainCoverageThreshold() {
    const int bayer[16]=int[16](0,8,2,10,12,4,14,6,3,11,1,9,15,7,13,5);
    ivec2 p=ivec2(gl_FragCoord.xy)&3;
    return (float(bayer[p.y*4+p.x])+0.5)/16.0;
}
