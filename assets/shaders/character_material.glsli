// The per-batch material of the character pass, set 1 binding 1. Both stages
// read it: the vertex shader picks and animates the UV, the fragment shader
// does the rest. Must match CharMaterialUBO in character_renderer.cpp.
layout(set = 1, binding = 1) uniform CharMaterial {
    float opacity;
    int alphaTest;
    int unlit;
    float specularIntensity;
    int enableNormalMap;
    int enablePOM;
    float pomScale;
    int pomMaxSamples;
    float heightMapVariance;
    float normalMapStrength;
    int hairMaterial;
    int ignoreTextureAlpha;
    // 0 for every layer but Mod (1) and Mod2x (0.5): the colour that
    // multiplies the scene by nothing, which fog and fades move toward.
    float modulateNeutral;
    // The UV the texture samples: 0 or 1 for a vertex set, -1 for the sphere
    // environment map.
    int texCoordSet;
    // 1 when the M2 material carries flag 0x04. Without it the client culls
    // the back of the surface, and so does the fragment shader.
    int twoSided;
    int materialPadUv;
    // The texture animation, as two rows of a 2x3 matrix (w is padding).
    // See m2_uv_transform.hpp.
    vec4 uvRow0;
    vec4 uvRow1;
    // What an aura multiplies the lit colour by: Shadowform's purple, a
    // ghost's blue (SpellVisualKit character procs). White without one.
    vec4 stateTint;
    // The batch's second stage, at set 1 binding 3, and how the two stages
    // combine (M2Combiner in m2_combiner.hpp; combineStages in
    // m2_combiner.glsli). Its UV: 0 or 1 for a vertex set animated by uv2Row*,
    // -1 for the sphere map, 2 for UV0 as it is.
    int hasSecondTexture;
    int texCoordSet2;
    int combiner;
    uint surfaceMaterialIndex; // evaluated-surface record; unused by forward draws
    // The batch's authored M2 colour, multiplied into the texture (w is
    // padding). A glow card is painted white and coloured here: the riding
    // phoenix's wing glows carry red, magenta and violet, and drew white
    // without it.
    vec4 batchColor;
    // The second stage's own texture animation.
    vec4 uv2Row0;
    vec4 uv2Row1;
};
