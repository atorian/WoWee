#include "rt_common.glsli"
#include "surface_encoding.glsli"
#include "surface_rt_data.glsli"
#ifdef SURFACE_MSAA
layout(set=0,binding=1) uniform usampler2DMS surfaceKeys;
layout(set=0,binding=2) uniform usampler2DMS surfacePayload;
#define LOAD_KEYS(p,s) texelFetch(surfaceKeys,p,int(s))
#define LOAD_PAYLOAD(p,s) texelFetch(surfacePayload,p,int(s))
#else
layout(set=0,binding=1) uniform usampler2D surfaceKeys;
layout(set=0,binding=2) uniform usampler2D surfacePayload;
#define LOAD_KEYS(p,s) texelFetch(surfaceKeys,p,0)
#define LOAD_PAYLOAD(p,s) texelFetch(surfacePayload,p,0)
#endif
layout(std430,set=0,binding=3) buffer RawLight { uvec2 rawLight[]; };
layout(std430,set=0,binding=4) writeonly buffer FilteredLight { uvec2 filteredLight[]; };
layout(std430,set=0,binding=5) buffer MissingReceivers { uint missing[]; };
layout(std430,set=0,binding=6) buffer Dispatch { uint groupsX; uint groupsY; uint groupsZ; uint missingCount; };
layout(std430,set=0,binding=7) readonly buffer Materials { SurfaceMaterial materials[]; };
layout(std430,set=0,binding=8) readonly buffer PreviousHistory { SurfaceHistory previousHistory[]; };
layout(std430,set=0,binding=9) buffer CurrentHistory { SurfaceHistory currentHistory[]; };
layout(push_constant) uniform SurfacePush { uint samples; uint maxDispatch; } pc;
struct Receiver { vec3 position; vec3 normal; float distance; uint material; uint depth; uint normalKey; };
uint sampleIndex(ivec2 p,uint s) { return (uint(p.y)*uint(pass.sceneExtent.x)+uint(p.x))*pc.samples+s; }
Receiver receiverAt(ivec2 p,uint s) {
    uvec4 keys=LOAD_KEYS(p,s), payload=LOAD_PAYLOAD(p,s);
    vec3 position=rtRelativeFromDepth((vec2(p)+0.5)*pass.sceneExtent.zw,uintBitsToFloat(payload.z));
    vec3 normal=unpackSurfaceNormal(keys.x);
    // A derivative cross product carries raster winding, not a guaranteed
    // outward orientation. Trace from the visible side of two-sided geometry.
    if(dot(normal,-position)<0.0)normal=-normal;
    return Receiver(position,normal,length(position),keys.w,payload.z,keys.x);
}
bool usable(Receiver r) {
    return r.material!=0u && r.distance>0.0 && (pass.misc.w<=0.0 || r.distance<pass.misc.w);
}
bool sameReceiver(Receiver a,Receiver b) {
    return a.material==b.material && dot(a.normal,b.normal)>0.99 &&
        abs(dot(a.position-b.position,a.normal))<0.01+0.002*a.distance;
}
