// Nearby solar visibility and faint, soft grounding use real animated/cutout
// geometry. Strong silhouettes affect direct sunlight, never ambient fill.
layout(set = 0, binding = 8) uniform sampler2D uContactShadow;

// x: direct-light visibility; y: soft ambient visibility.
vec2 localShadowAt(vec3 worldPos) {
    if (contactParams.x < 0.5 || shadowParams.x < 0.5) return vec2(1.0);
    vec4 clip = contactSpaceMatrix * vec4(worldPos, 1.0);
    vec3 projected = clip.xyz / clip.w;
    vec2 uv = projected.xy * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))) ||
        projected.z <= 0.0 || projected.z >= 1.0) return vec2(1.0);
    float solarOcclusion = 0.0;
    float ambientOcclusion = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 offset = vec2(x, y) * contactParams.y;
            float depth = texture(uContactShadow, uv + offset).r;
            float gap = (projected.z - depth) * contactParams.z;
            solarOcclusion += smoothstep(0.03, 0.06, gap);
            // Six texels = 19 cm: a soft patch at the feet, not a second hard
            // body silhouette in an existing building/terrain shadow.
            float softDepth = texture(uContactShadow, uv + offset * 6.0).r;
            float softGap = (projected.z - softDepth) * contactParams.z;
            ambientOcclusion += smoothstep(0.03, 0.06, softGap) *
                                (1.0 - smoothstep(0.3, 1.0, softGap));
        }
    }
    float edge = 1.0 - smoothstep(0.85, 1.0, max(abs(projected.x), abs(projected.y)));
    return vec2(1.0 - edge * solarOcclusion / 9.0,
                1.0 - contactParams.w * edge * ambientOcclusion / 9.0);
}
