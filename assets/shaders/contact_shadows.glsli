// The units' shadow map, and how every surface takes a shadow, as WoW 3.3.5a
// does it (WoW.exe 12340, the extShadowQuality map and the receiving pixel
// shaders terrain2_pcf, mapobj*, combiners_*).
//
// The client keeps one map 40 yards across around the player, and everything
// near the player casts into it: players, creatures, mounts and riders, and at
// the highest setting the models standing about. This is that map. The sun
// map further out stands for the client's cascades.
layout(set = 0, binding = 8) uniform sampler2D uContactShadow;

#include "shadow_shading.glsli"

// Indoors the units' shadows stay below the player's head: they fade out
// between two and three yards above the player's feet, so a unit does not
// shadow the ceiling or the upper wall of the room it stands in. The client
// does this for interior groups and for models lit as indoors.
float unitShadowAboveFade(vec3 worldPos) {
    return clamp(worldPos.z - (playerPos.z + 2.0), 0.0, 1.0);
}

// The units' map at worldPos: 1 lit, 0 in shadow.
float localShadowAt(vec3 worldPos) {
    if (contactParams.x < 0.5 || shadowParams.x < 0.5) return 1.0;
    vec4 clip = contactSpaceMatrix * vec4(worldPos, 1.0);
    vec3 projected = clip.xyz / clip.w;
    vec2 uv = projected.xy * 0.5 + 0.5;
    // The receiver's own depth slope across the map, taken before anything
    // returns early. A doodad is drawn into this map as well as receiving it:
    // compared at a flat depth, a dock's planks at a low sun shadowed
    // themselves in stripes a texel wide.
    vec3 receiver = vec3(uv, projected.z);
    vec3 dx = dFdx(receiver);
    vec3 dy = dFdy(receiver);
    float det = dx.x * dy.y - dx.y * dy.x;
    vec2 slope = abs(det) < 1e-14 ? vec2(0.0)
        : clamp(vec2(dy.y * dx.z - dx.y * dy.z, dx.x * dy.z - dy.x * dx.z) / det,
                vec2(-64.0), vec2(64.0));
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))) ||
        projected.z <= 0.0 || projected.z >= 1.0) return 1.0;
    // Half a texel of that slope: how far a receiver can sit from the centre
    // its caster's depth was stored at.
    float quantization = 0.5 * contactParams.y * (abs(slope.x) + abs(slope.y)) * contactParams.z;
    float occlusion = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 offset = vec2(x, y) * contactParams.y;
            float depth = texture(uContactShadow, uv + offset).r;
            float gap = (projected.z + dot(slope, offset) - depth) * contactParams.z - quantization;
            occlusion += smoothstep(0.03, 0.06, gap);
        }
    }
    return 1.0 - shadowMapEdgeFade(projected.xy) * occlusion / 9.0;
}
