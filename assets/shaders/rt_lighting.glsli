// Ray traced lighting as the surface shaders read it (RtLighting).
//
// The result was traced last frame, so a surface finds its texels by
// projecting its world position with that frame's matrix, and trusts them only
// where the distance stored there matches its own - anything else is a surface
// that was hidden, off screen or somewhere else last frame. Where nothing
// matches, every term falls back to what the shader computed without ray
// tracing.
//
// The including shader must declare, at the end of its PerFrame block:
//     mat4 rtViewProj;   // camera-relative projection in the traced frame
//     vec4 rtCameraPos;  // its camera position
//     vec4 rtParams;     // x = mode (0 off, 1 sun, 2 +AO, 3 +bounce)

layout(set = 0, binding = 3) uniform sampler2D uRtLight;  // r sun, g AO, a distance
layout(set = 0, binding = 4) uniform sampler2D uRtGi;     // rgb indirect correction

layout(set = 0, binding = 6) uniform sampler2D uRtReflection;
layout(set = 0, binding = 7) uniform sampler2D uRtGeometry;

vec3 rtReceiverNormal(vec2 e) {
    vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) *
        vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return normalize(n);
}

#include "rt_light_composition.glsli"

// Most receivers still occupy the same plane in the previous frame. Verify
// the four texels of their bilinear footprint before filtering any light:
// hardware filtering alone would mix foreground lighting into the background
// at a silhouette. Only a complete, confident footprint takes this path.
bool rtBilinearLight(vec2 f, float expected, vec2 distanceGradient,
                     vec3 receiverNormal, out RtLight result) {
    ivec2 size = textureSize(uRtLight, 0);
    ivec2 base = ivec2(floor(f));
    if (any(lessThan(base, ivec2(0))) || any(greaterThanEqual(base + 1, size))) return false;
    vec2 fraction = fract(f);
    vec2 sunAo = vec2(0.0);
    bool checkNormal = dot(receiverNormal, receiverNormal) > 0.5;
    for (int i = 0; i < 4; ++i) {
        ivec2 o = ivec2(i & 1, i >> 1);
        ivec2 q = base + o;
        float predicted = expected + dot(vec2(q) - f, distanceGradient);
        vec4 light = texelFetch(uRtLight, q, 0);
        // Stay well inside the recovery filter's depth tolerance. All four
        // taps must describe this receiver, including on sloping surfaces.
        float tolerance = 0.25 * (0.03 * predicted + 0.05);
        if (predicted <= 0.0 || light.a <= 0.0 || abs(light.a - predicted) > tolerance) return false;
        if (checkNormal) {
            vec4 geometry = texelFetch(uRtGeometry, q, 0);
            if (geometry.z <= 0.0 || dot(rtReceiverNormal(geometry.xy), receiverNormal) < 0.85) return false;
        }
        float w = (o.x == 1 ? fraction.x : 1.0 - fraction.x) *
                  (o.y == 1 ? fraction.y : 1.0 - fraction.y);
        sunAo += light.rg * w;
    }
    // The GI sampler is linear. Its entire footprint has just been checked,
    // so one filtered read replaces the gather's per-tap GI reads safely.
    vec3 gi = rtParams.x > 2.5
        ? textureLod(uRtGi, (f + 0.5) / vec2(size), 0.0).rgb : vec3(0.0);
    result = RtLight(1.0, sunAo.x, sunAo.y, gi);
    return true;
}

// Test each tap before interpolating: a half-resolution texel at a silhouette
// can belong to the foreground or the surface behind it. Predict the distance
// on the receiver's local plane, so sloping ground can use neighbouring taps.
RtLight rtGatherLight(vec2 f, float expected, vec2 distanceGradient, int radius, vec3 receiverNormal) {
    RtLight r = RtLight(0.0, 1.0, 1.0, vec3(0.0));
    ivec2 size = textureSize(uRtLight, 0);
    ivec2 center = ivec2(floor(f + 0.5));
    float wsum = 0.0;
    float best = 0.0;
    vec2 sunAo = vec2(0.0);
    vec3 gi = vec3(0.0);
    bool wantGi = rtParams.x > 2.5;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            if (radius > 1 && x == 0 && y == 0) continue;
            ivec2 q = center + ivec2(x, y) * radius;
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) continue;
            vec2 o = vec2(q) - f;
            float predicted = expected + dot(distanceGradient, o);
            if (predicted <= 0.0) continue;
            vec4 l = texelFetch(uRtLight, q, 0);
            // Wider searches need a closer depth match; never substitute the
            // background just because it has a nearby screen coordinate.
            float tolerance = radius == 1 ? 0.03 * predicted + 0.05
                                          : 0.01 * predicted + 0.02;
            float e = (l.a - predicted) / tolerance;
            float match = l.a > 0.0 ? exp(-e * e) : 0.0;
            // Thin nearby surfaces can share distance while facing different
            // ways (the lamp lid, stem and light cone). Depth alone transferred
            // their shadow/AO onto each other when the camera moved.
            if (dot(receiverNormal, receiverNormal) > 0.5) {
                vec4 geometry = texelFetch(uRtGeometry, q, 0);
                match *= geometry.z > 0.0
                    ? smoothstep(0.65, 0.85, dot(rtReceiverNormal(geometry.xy), receiverNormal)) : 0.0;
            }
            float w = match * exp(-dot(o, o) / float(radius * radius));
            if (w <= 1e-4) continue;
            best = max(best, match);
            wsum += w;
            sunAo += l.rg * w;
            if (wantGi) gi += texelFetch(uRtGi, q, 0).rgb * w;
        }
    }
    if (wsum <= 1e-4) return r;
    r.weight = smoothstep(0.1, 0.6, best);
    r.sun = sunAo.x / wsum;
    r.ao = sunAo.y / wsum;
    r.indirectDelta = gi / wsum;
    return r;
}

RtLight rtLightAtProjected(vec2 f, float expected, vec2 distanceGradient,
                           vec3 receiverNormal) {
    RtLight r = RtLight(0.0, 1.0, 1.0, vec3(0.0));
    if (rtParams.x < 0.5) return r;
    if (rtBilinearLight(f, expected, distanceGradient, receiverNormal, r)) return r;
    r = rtGatherLight(f, expected, distanceGradient, 1, receiverNormal);
    // The trace belongs to the previous frame. An animated edge or the strip
    // it just uncovered may have no receiver in the local 3x3 taps. Recover
    // nearby lighting from the same surface before reverting to flat ambient,
    // which otherwise draws a bright moving rim. Stop at the first good ring;
    // stable pixels keep the cheap local lookup and shadow edges stay local.
    for (int radius = 2; radius <= 16 && r.weight < 0.999; radius *= 2) {
        RtLight nearby = rtGatherLight(f, expected, distanceGradient, radius, receiverNormal);
        if (nearby.weight > r.weight) r = nearby;
    }
    return r;
}

// Sharp reflected radiance uses only local taps on the same plane. The
// diffuse recovery rings would smear neighbouring walls into a pane.
vec4 rtReflectionAtProjected(vec2 f, float expected, vec3 normal) {
    if (rtParams.x < 0.5) return vec4(0.0);
    ivec2 size = textureSize(uRtReflection, 0);
    ivec2 base = ivec2(floor(f));
    vec2 fraction = fract(f);
    vec3 sum = vec3(0.0);
    float wsum = 0.0;
    for (int i = 0; i < 4; ++i) {
        ivec2 o = ivec2(i & 1, i >> 1), q = base + o;
        if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) continue;
        vec4 geometry = texelFetch(uRtGeometry, q, 0);
        vec4 reflection = texelFetch(uRtReflection, q, 0);
        float alignment = dot(rtReceiverNormal(geometry.xy), normal);
        if (reflection.a <= 0.0 || geometry.z <= 0.0 || alignment < 0.9 ||
            abs(geometry.z - expected) > 0.01 * expected + 0.05) continue;
        float w = (o.x == 1 ? fraction.x : 1.0 - fraction.x) *
                  (o.y == 1 ? fraction.y : 1.0 - fraction.y);
        sum += reflection.rgb * w;
        wsum += w;
    }
    return wsum > 0.05 ? vec4(sum / wsum, min(wsum, 1.0)) : vec4(0.0);
}

#ifndef RT_LOOKUP_PROBE
RtLight rtLightAt(vec3 worldPos, vec3 receiverNormal) {
    // Uniform across the draw, so this early return keeps derivatives valid.
    if (rtParams.x < 0.5) return RtLight(0.0, 1.0, 1.0, vec3(0.0));
    vec3 relativePos = worldPos - rtCameraPos.xyz;
    vec4 clip = rtViewProj * vec4(relativePos, 1.0);
    vec2 uv = clip.xy / clip.w * 0.5 + 0.5;
    vec2 f = uv * vec2(textureSize(uRtLight, 0)) - 0.5;
    float expected = length(relativePos);
    // Solve the screen-space distance gradient before any per-pixel early
    // return. Derivatives describe the receiver triangle, including at its
    // edge; neighbouring depths may describe an entirely different surface.
    vec2 dx = dFdx(f), dy = dFdy(f);
    float ex = dFdx(expected), ey = dFdy(expected);
    float det = dx.x * dy.y - dx.y * dy.x;
    vec2 gradient = abs(det) > 1e-6
        ? vec2(ex * dy.y - ey * dx.y, ey * dx.x - ex * dy.x) / det : vec2(0.0);
    gradient = clamp(gradient, vec2(-0.25 * expected), vec2(0.25 * expected));
    if (rtParams.x < 0.5 || clip.w <= 0.0 ||
        any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) {
        return RtLight(0.0, 1.0, 1.0, vec3(0.0));
    }
    if (dot(receiverNormal, -relativePos) < 0.0) receiverNormal = -receiverNormal;
    return rtLightAtProjected(f, expected, gradient, receiverNormal);
}

vec4 rtReflectionAt(vec3 worldPos, vec3 normal) {
    if (rtParams.x < 0.5) return vec4(0.0);
    vec3 relativePos = worldPos - rtCameraPos.xyz;
    vec4 clip = rtViewProj * vec4(relativePos, 1.0);
    vec2 uv = clip.xy / clip.w * 0.5 + 0.5;
    if (clip.w <= 0.0 || any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))))
        return vec4(0.0);
    if (dot(normal, -relativePos) < 0.0) normal = -normal;
    vec2 f = uv * vec2(textureSize(uRtReflection, 0)) - 0.5;
    return rtReflectionAtProjected(f, length(relativePos), normal);
}
#endif
