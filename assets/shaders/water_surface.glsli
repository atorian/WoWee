// Where a point of the still water is drawn: carried by the wind's sea as
// far as geometry this fine can carry it, and by the player's ripple.
// Shared by the vertex stage, which moves the water's own mesh, and the
// tessellation evaluation stage, which moves the finer mesh near the
// camera - both go by `step`, the yards between the vertices doing it.
//
// Needs, declared before it: the PerFrame block (fogParams, playerPos), the
// water push block (push.*), WaterFrameData and the sea's surface
// (ocean_surface.glsli).

vec3 displacedWaterPoint(vec3 rest, float step, float time) {
    vec3 displacement = vec3(0.0);
    if (push.liquidBasicType >= 1.5) {
        // Magma and slime: a slow undulation, far longer than any step.
        float amp = push.waveAmp, freq = push.waveFreq, spd = push.waveSpeed;
        float wave = sin(rest.x * freq * 0.5 + time * spd * 0.3) * 0.4
                   + sin(rest.y * freq * 0.3 + time * spd * 0.5) * 0.3;
        displacement.z = wave * amp * 0.5;
    } else if (push.displaced > 0.5) {
        // The wind's sea, where this surface moves at all: under a passing
        // wave a point of the water goes round a circle, up and down and
        // toward each crest as it comes, which draws crests sharp and
        // troughs wide (ocean_fft.glsli).
        displacement = oceanDisplacementAt(rest.xy, step);
    }
    vec3 p = rest + displacement;

    // The player's ripple: rings spreading from where they swim.
    float d = length(p.xy - playerPos.xy);
    p.z += fogParams.w * 0.12 * exp(-d * 0.12) * sin(d * 2.5 - time * 6.0);
    return p;
}
