// Sampling the sun's shadow map without lifting a shadow off the feet that
// cast it.
//
// A receiver is compared, at each PCF tap, against its own plane's depth at
// that tap - the plane of its surface normal, shadow_plane.glsli - so a flat
// floor needs no depth bias to keep from shadowing itself. What is left is
// the half texel a receiver can sit from the centre the caster's depth was
// stored at, and a hand's breadth in yards.
//
// It replaces a bias of 0.0005 of the map's whole depth range. The range is
// 6.5 times the shadow distance, so at the largest distance that was 1.6
// yards along the light at a low sun: a gnome's shadow began past where it
// ended.
//
// Needs lightSpaceMatrix and shadowTexel() declared before it is included.

#include "shadow_plane.glsli"

// The plane of the triangle being drawn, as a normal of any length: how the
// world position runs across the pixel quad. Every pixel of a quad, the
// helpers included, is the same triangle's, so this is its own plane however
// the camera looks at it - which is what the map stored its depth from. The
// interpolated normal is not: a leaf card's is bent outward for soft light,
// and a column's rounds its flat faces.
//
// Take it first thing in main(), before any discard: once a pixel of the quad
// has been discarded, the quad's derivatives are undefined, and an alpha-
// tested leaf's edge took its shadow from whatever they came out as.
vec3 receiverFaceNormal(vec3 worldPos) {
    return cross(dFdx(worldPos), dFdy(worldPos));
}

// How far the receiver's depth runs per unit of the sun map's uv, on the
// plane of `normal` (world space, any length, either side).
vec2 shadowReceiverSlope(vec3 normal) {
    return shadowPlaneSlope(lightSpaceMatrix, normal);
}

// Map depth per yard along the light: the length of the light space
// matrix's depth row.
float shadowDepthPerYard() {
    return length(vec3(lightSpaceMatrix[0][2], lightSpaceMatrix[1][2], lightSpaceMatrix[2][2]));
}

// 3x3 PCF with each tap compared at the receiver's own plane.
float sampleShadowReceiverPlane(sampler2DShadow smap, vec3 proj, vec2 slope) {
    float texel = shadowTexel();
    float bias = 0.5 * texel * (abs(slope.x) + abs(slope.y)) + 0.03 * shadowDepthPerYard();
    float shadow = 0.0;
    for (int x = -1; x <= 1; ++x) {
        for (int y = -1; y <= 1; ++y) {
            vec2 offset = vec2(x, y) * texel;
            float depth = proj.z + dot(slope, offset) - bias;
            shadow += texture(smap, vec3(proj.xy + offset, depth));
        }
    }
    return shadow / 9.0;
}
