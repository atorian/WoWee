// The main camera samples an integrated frustum volume once per surface.
// Reflection cameras cannot use its UV/depth mapping: integrate the same
// medium on a shorter eight-cell ray, without local shadow/light detail.
vec4 atmosphereFallback(vec3 direction) {
    float distance = length(direction);
    if (distance < 0.001) return vec4(0,0,0,1);
    vec3 ray = direction/distance;
    vec4 air = vec4(0,0,0,1);
    float front = 0.0;
    for (int i=0; i<8; ++i) {
        float u = float(i+1)/8.0;
        float back = distance*u*u;
        float height = viewPos.z + ray.z*(front+back)*0.5;
        vec2 density = atmosphereAt(height);
        float extinction = density.x+density.y;
        air = integrateAtmosphereCell(air,
            atmosphereSource(height,ray,1.0)*extinction,extinction,back-front);
        front = back;
    }
    return air;
}
vec4 atmosphereVolumeAt(vec3 worldPos) {
    vec4 clip = projection*view*vec4(worldPos,1);
    float depth = max(clip.w,0.0);
    if (depth <= 0.0) return vec4(0,0,0,1);
    vec2 uv = clip.xy/max(depth,1e-4)*0.5+0.5;
    float slice = log(max(depth,volumetricParams.y)/volumetricParams.y)*volumetricParams.z;
    vec4 air = textureLod(uFogVolume,vec3(uv,slice-0.5/volumetricParams.w),0);
    // First stored sample is the far edge of cell zero. Interpolate from
    // vacuum at the eye instead of applying that entire cell to nearby faces.
    float first = volumetricParams.y*exp(1.0/(volumetricParams.w*volumetricParams.z));
    return mix(vec4(0,0,0,1),air,clamp(depth/first,0.0,1.0));
}
vec4 worldAtmosphere(vec3 worldPos) {
    vec3 direction = worldPos-viewPos.xyz;
    vec4 air = volumetricParams.x>0.5 ? atmosphereVolumeAt(worldPos) : atmosphereFallback(direction);
    float boundary = atmosphereBoundary(direction);
    if (boundary < 1.0) {
        vec3 background = aerialBackgroundAt(direction);
        vec4 clip = projection*view*vec4(worldPos,1);
        vec2 uv = clip.xy/max(clip.w,1e-4)*0.5+0.5;
        vec4 farAir = volumetricParams.x>0.5 ? textureLod(uFogVolume,vec3(uv,1),0) :
            atmosphereFallback(normalize(direction)*fogSkyBand1.w);
        // Geometry retirement is independent of optical density. Match the
        // fully integrated sky, not its unattenuated captured background.
        vec3 sky = background*farAir.a+farAir.rgb;
        air = vec4(mix(sky,air.rgb,boundary),air.a*boundary);
    }
    return air;
}
vec3 aerialColorAt(vec3 direction) { return aerialBackgroundAt(direction); }
