// The swell: six Gerstner waves under the water's surface, shared by the two
// stages so they agree on what the waves are. The vertex stage moves the mesh
// by the waves the mesh is fine enough to carry; the fragment stage lights the
// surface by every wave a pixel is big enough to show. Neither takes a wave
// further than that - a wave sampled more coarsely than it repeats does not
// vanish, it comes back as a slow false pattern of its own.
//
// Coordinate system: X,Y = horizontal plane, Z = up.
//
// Water and ocean only; magma and slime have their own slow undulation in
// water.vert. Expects the water push block (`push.waveAmp`, `push.waveFreq`,
// `push.waveSpeed`, `push.liquidBasicType`) to be declared before it.

const int kSwellWaves = 6;

struct SwellWave {
    vec2 dir;
    float freq;       // radians a yard
    float amp;        // yards
    float speed;
    float steepness;  // how far the crests lean (Gerstner Q, before the per-wave share)
};

SwellWave swellWave(int i) {
    // Spread across many angles so no direction dominates.
    const vec2 dirs[kSwellWaves] = vec2[kSwellWaves](
        vec2( 0.86,  0.51) / length(vec2( 0.86,  0.51)),
        vec2(-0.47,  0.88) / length(vec2(-0.47,  0.88)),
        vec2( 0.32, -0.95) / length(vec2( 0.32, -0.95)),
        vec2(-0.93, -0.37) / length(vec2(-0.93, -0.37)),
        vec2( 0.67, -0.29) / length(vec2( 0.67, -0.29)),
        vec2(-0.15,  0.74) / length(vec2(-0.15,  0.74)));
    // Ocean: a broader range of scales, for chop over the swell.
    const float oceanAmp[kSwellWaves]   = float[kSwellWaves](1.0, 0.55, 0.30, 0.18, 0.10, 0.06);
    const float oceanFreq[kSwellWaves]  = float[kSwellWaves](0.7, 1.3, 2.1, 3.4, 5.0, 7.5);
    const float oceanSpeed[kSwellWaves] = float[kSwellWaves](0.8, 1.0, 1.3, 1.6, 2.0, 2.5);
    const float oceanSteep[kSwellWaves] = float[kSwellWaves](0.35, 0.30, 0.25, 0.20, 0.15, 0.10);
    // Inland water: gentle, but still more than one scale.
    const float inlandAmp[kSwellWaves]   = float[kSwellWaves](0.5, 0.25, 0.15, 0.08, 0.05, 0.03);
    const float inlandFreq[kSwellWaves]  = float[kSwellWaves](1.0, 1.8, 3.0, 4.5, 7.0, 10.0);
    const float inlandSpeed[kSwellWaves] = float[kSwellWaves](0.6, 0.9, 1.2, 1.5, 1.9, 2.3);
    const float inlandSteep[kSwellWaves] = float[kSwellWaves](0.20, 0.18, 0.15, 0.12, 0.10, 0.08);

    bool ocean = push.liquidBasicType > 0.5;
    SwellWave w;
    w.dir = dirs[i];
    w.freq = push.waveFreq * (ocean ? oceanFreq[i] : inlandFreq[i]);
    w.amp = push.waveAmp * (ocean ? oceanAmp[i] : inlandAmp[i]);
    w.speed = push.waveSpeed * (ocean ? oceanSpeed[i] : inlandSpeed[i]);
    w.steepness = ocean ? oceanSteep[i] : inlandSteep[i];
    return w;
}

struct Swell {
    vec3 displacement;  // where the point on the rest surface has moved to
    vec2 slope;         // dHeight/dX, dHeight/dY
    float lean;         // how much the crests pinch the surface together
    float height;       // the waves' raw height, for crest foam
};

Swell noSwell() {
    Swell s;
    s.displacement = vec3(0.0);
    s.slope = vec2(0.0);
    s.lean = 0.0;
    s.height = 0.0;
    return s;
}

// Adds `share` (0..1) of wave `w` at rest position `pos`.
void addSwellWave(inout Swell s, SwellWave w, float share, vec2 pos, float time) {
    if (share <= 0.0 || w.amp <= 0.0) return;
    float A = w.amp * share;
    float Q = clamp(w.steepness / (w.freq * w.amp * float(kSwellWaves)), 0.0, 1.0);
    float phase = w.freq * dot(w.dir, pos) + w.speed * w.freq * time;
    float sn = sin(phase);
    float cs = cos(phase);
    s.displacement += vec3(Q * A * w.dir * cs, A * sn);
    s.slope += w.dir * (w.freq * A * cs);
    s.lean += Q * w.freq * A * sn;
    s.height += A * sn;
}

// The surface's normal under the swell, facing up.
vec3 swellNormal(Swell s) {
    return normalize(vec3(-s.slope, 1.0 - s.lean));
}
