// The wind: the one copy of how it moves what it moves.
//
// One field blows over everything - the trees, their shadows, the cloth and
// the grass - from one direction at one speed (WindField, wind_field.hpp). It
// is a deterministic function of the realm's clock and the zone, so two
// clients standing in the same place see the same weather in the trees.
//
// Every caller is handed the same numbers in the same shape: the main passes
// from the PerFrame block (perFrameFoliageWind and friends below, when the
// includer declares WIND_PER_FRAME), the shadow pass from its caster's data
// and its push constants (foliageWindFromShadowCaster). They call the
// identical function, so a tree and its shadow cannot drift apart again -
// which is how this file came to exist: m2.vert.glsl and shadow.vert.glsl
// each kept a copy of three sine layers that a comment said matched.
//
// TIME. Nothing here reads a clock. Each moving layer has a phase the CPU
// accumulates, phase += dt * rate(speed), so the rate can follow the wind
// without every tree jumping to where the new rate says it would have been
// all along. The phases arrive wrapped to [0, 20*pi): every multiple a phase
// is taken at below is a multiple of 0.1, which keeps sin(k * phase)
// continuous across the wrap. The grass fronts arrive as distances travelled,
// wrapped to [0, 200*pi) yards, and are taken at spatial frequencies that are
// multiples of 0.01 for the same reason. Keep both rules when changing a
// constant here.
//
// DIRECTION. `dir` is where the wind blows toward, a unit vector in the space
// the displacement is applied in: the model's own xy for foliage and cloth
// (windDirectionInModel), world xy for grass.
//
// test_wind_field.cpp compiles this file as C++ against glm, to run it: keep
// it to what both languages read the same way - no swizzles, no `out`
// parameters, no vector times a bare literal.

// ---- Foliage: trees, bushes, ferns (M2 sway mode 1) ------------------------

struct FoliageWind {
    vec2 dir;      // toward, in the model's own xy, unit length
    float lean;    // how far downwind the plant leans, in units of its amplitude
    float swing;   // trunk amplitude scale; 1 at the speed the layers were tuned at
    float detail;  // branch and leaf amplitude scale
    vec3 phase;    // trunk, branch, leaf
};

// Displacement in the model's own xy for a vertex at `pos` (as drawn) and
// `restPos` (as authored), of an instance standing at `worldRef`, with `amp`
// the model's throw already scaled by the height up the plant and the
// distance fade.
//
// Three layers. The trunk bends along the wind - a lean that grows with the
// speed, and a slow swing about it - and a little across it. The branches
// and the leaves ride on that at their own rates, with a per-branch and a
// per-vertex phase so a canopy shimmers rather than swaying as one plank.
vec2 foliageWindSway(FoliageWind w, vec3 pos, vec3 restPos, vec2 worldRef, float amp) {
    vec2 across = vec2(-w.dir.y, w.dir.x);

    float trunkPhase = w.phase.x + dot(worldRef, vec2(0.1, 0.13));
    float alongAmt  = w.lean + sin(trunkPhase) * 0.35 * w.swing;
    float acrossAmt = cos(trunkPhase * 0.7) * 0.25 * w.swing;

    float branchPhase = w.phase.y + dot(worldRef, vec2(0.37, 0.71));
    alongAmt  += sin(branchPhase + pos.y * 0.4) * 0.15 * w.detail;
    acrossAmt += cos(branchPhase * 1.1 + pos.x * 0.3) * 0.12 * w.detail;

    float leafPhase = w.phase.z + dot(restPos, vec3(1.7, 2.3, 0.9));
    alongAmt  += sin(leafPhase) * 0.06 * w.detail;
    acrossAmt += cos(leafPhase * 1.3) * 0.05 * w.detail;

    return (w.dir * alongAmt + across * acrossAmt) * amp;
}

// A shadow caster's wind (M2ShadowInstance::wind) and the frame's phases
// (M2ShadowPush::windPhases), as shadowWindFor in wind_field.hpp packs them.
FoliageWind foliageWindFromShadowCaster(vec4 wind, vec4 phases) {
    FoliageWind w;
    w.dir = vec2(wind.x, wind.y);
    w.lean = wind.z;
    w.swing = wind.w;
    w.detail = phases.w;
    w.phase = vec3(phases.x, phases.y, phases.z);
    return w;
}

// ---- Cloth: banners, flags, tapestries (M2 modes 3/4, WMO cloth) ----------

struct ClothWind {
    vec2 dir;     // toward, in the model's own xy, unit length
    float lean;   // as FoliageWind's
    float swing;  // amplitude scale
    float phase;
};

// Displacement in the model's own space for a vertex of cloth at `pos` with
// face normal `normal`, hung at `worldRef`, `amp` the throw at this vertex.
//
// A slow sway of the whole cloth and a smaller ripple across it, so it
// breathes rather than swinging like a sign, pushed downwind by the lean.
//
// Away from the wall, never into it. A banner hangs flush against stone, so
// any motion toward its own back face goes through the masonry - a quarter of
// it was still enough to show. The whole perpendicular component is taken out
// and a third of it given back outward only: the cloth billows away from the
// wall and slides in its own plane, and the half-cycle that used to push it
// backwards does nothing at all. Outward is each face's own normal, so a
// two-sided banner puffs slightly rather than parting - which is what a cloth
// in a draught does anyway.
vec3 clothWindSway(ClothWind w, vec3 pos, vec3 normal, vec2 worldRef, float amp) {
    vec2 across = vec2(-w.dir.y, w.dir.x);
    // Per banner rather than per vertex, so two on the same wall are not in
    // step - the phase comes from where the cloth hangs.
    float p = w.phase + dot(worldRef, vec2(0.21, 0.17));

    float alongAmt  = w.lean * 2.0 + (sin(p) * 0.7 + sin(p * 2.7 + pos.y * 1.9) * 0.25) * w.swing;
    float acrossAmt = (cos(p * 0.9) * 0.6 + cos(p * 3.1 + pos.x * 1.7) * 0.2) * w.swing;
    // A little in and out as well, so the cloth is not a flat sheet sliding
    // sideways.
    float inOut = sin(p * 1.6 + pos.x * 1.3) * 0.12 * w.swing * amp;
    vec3 sway = vec3((w.dir * alongAmt + across * acrossAmt) * amp, inOut);

    vec3 clothN = normalize(normal);
    float perp = dot(sway, clothN);
    float outward = (perp > 0.0 ? perp : 0.0) * 0.35;
    return sway - clothN * perp + clothN * outward;
}

// ---- Grass blades -----------------------------------------------------------

struct GrassWind {
    vec2 dir;          // toward, in world xy, unit length
    float swing;       // amplitude scale
    float waveTravel;  // yards the fronts have travelled downwind
    float gustTravel;  // yards the gust swells have travelled
    float rustlePhase;
};

// How the wind lays a blade rooted at `root` over: xy the way it bends (unit,
// world), z how far as a fraction of the full bend.
//
// Travelling waves. `wave` is a front about thirteen yards wide sweeping
// along the wind; `gustBand` is a far larger swell rolling through on top, so
// the field surges and rests instead of pulsing; `rustle` is the per-blade
// flutter riding on both. The bend direction also wobbles across the wind as
// a front passes, which is what makes a wave look like it pushes through the
// grass rather than dimming and brightening it.
vec3 grassWindBend(GrassWind w, vec2 root, float seed) {
    float alongWind = dot(root, w.dir);
    float frontPhase = (alongWind - w.waveTravel) * 0.48;

    float wave     = sin(frontPhase);
    float gustBand = 0.55 + 0.45 * sin((alongWind - w.gustTravel) * 0.11);
    float rustle   = sin(w.rustlePhase + dot(root, vec2(0.37, 0.71)) + seed * 6.2831853);

    vec2 across = vec2(-w.dir.y, w.dir.x);
    float wobble = 0.30 * sin(frontPhase + 1.3) + (seed - 0.5) * 0.35;
    vec2 bendDir = normalize(w.dir + across * wobble);
    float amount = (0.30 + 0.50 * (0.5 + 0.5 * wave) * gustBand) * (0.82 + 0.18 * rustle) * w.swing;
    return vec3(bendDir, amount);
}

// ---- The wind's direction in a model's own space ----------------------------

// The world-space direction `dirWorld` turned into the xy of a model drawn
// with `model`, whose sway is applied before the model matrix. The inverse
// rotation is the transpose of the rotation, and the scale the transpose
// keeps is normalised away. Matches windDirectionInModel in wind_field.hpp,
// which fills the shadow pass's push constants with the same answer.
vec2 windDirectionInModel(mat4 model, vec2 dirWorld) {
    vec3 t = transpose(mat3(model)) * vec3(dirWorld, 0.0);
    vec2 d = vec2(t.x, t.y);
    float len = length(d);
    return len > 1e-6 ? d / len : vec2(1.0, 0.0);
}

// ---- From the PerFrame block -------------------------------------------------

#ifdef WIND_PER_FRAME
// The includer's PerFrame block declares, after contactParams:
//   vec4 windDirLean;  // xy = toward (world), z = lean, w = swing
//   vec4 windPhases;   // x = trunk, y = branch, z = leaf, w = detail
//   vec4 windTravel;   // x = cloth phase, y = grass fronts, z = grass swells,
//                      // w = grass rustle phase
FoliageWind perFrameFoliageWind(mat4 model) {
    FoliageWind w;
    w.dir = windDirectionInModel(model, vec2(windDirLean.x, windDirLean.y));
    w.lean = windDirLean.z;
    w.swing = windDirLean.w;
    w.detail = windPhases.w;
    w.phase = vec3(windPhases.x, windPhases.y, windPhases.z);
    return w;
}

ClothWind perFrameClothWind(mat4 model) {
    ClothWind w;
    w.dir = windDirectionInModel(model, vec2(windDirLean.x, windDirLean.y));
    w.lean = windDirLean.z;
    w.swing = windDirLean.w;
    w.phase = windTravel.x;
    return w;
}

GrassWind perFrameGrassWind() {
    GrassWind w;
    w.dir = vec2(windDirLean.x, windDirLean.y);
    w.swing = windDirLean.w;
    w.waveTravel = windTravel.y;
    w.gustTravel = windTravel.z;
    w.rustlePhase = windTravel.w;
    return w;
}
#endif
